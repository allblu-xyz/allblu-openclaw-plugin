{
  "name": "openclaw-plugin-allblu-crypto-swap-quotes",
  "version": "0.1.1",
  "description": "Read-only allblu cryptocurrency swap quotes and supported assets for OpenClaw.",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "allblu",
    "crypto",
    "cryptocurrency",
    "cross-chain",
    "crypto-swap",
    "swap-quotes",
    "bitcoin",
    "ethereum",
    "solana",
    "polkadot",
    "tron",
    "trx",
    "stablecoins",
    "usdc",
    "usdt",
    "wbtc",
    "defi",
    "read-only"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/allblu-xyz/allblu-openclaw-plugin.git"
  },
  "homepage": "https://github.com/allblu-xyz/allblu-openclaw-plugin#readme",
  "bugs": {
    "url": "https://github.com/allblu-xyz/allblu-openclaw-plugin/issues"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "typebox": "1.3.34"
  },
  "peerDependencies": {
    "openclaw": ">=2026.10.3"
  },
  "devDependencies": {
    "openclaw": "2026.10.3",
    "typescript": "7.0.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.10.3"
    },
    "build": {
      "openclawVersion": "2026.10.3"
    }
  }
}
